# Copy to .dev.vars for local `wrangler dev`. .dev.vars is git-ignored.
# In production these are set via `wrangler secret put <NAME>`.

# OAuth client from Google Cloud Console (type: Web application)
GOOGLE_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxx"

# Your Google account's stable user id (the `sub` claim). Only this account
# is allowed to use the server.
# Set it to SETUP once to have the server tell you your own id, then replace
# it with that value. See README step 5.
ALLOWED_GOOGLE_SUB="SETUP"

# openssl rand -base64 32
TOKEN_SIGNING_KEY="replace-me-with-32-random-bytes-base64"
ENCRYPTION_KEY="replace-me-with-32-random-bytes-base64"
